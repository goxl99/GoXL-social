# Copy to .env.local and fill in. Never commit .env.local.
NEXT_PUBLIC_SUPABASE_URL=https://hgdltduqwayfepzuurke.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<publishable anon key from Supabase > Settings > API>
NEXT_PUBLIC_BASE_PATH=/business-live
# Public URL of this app INCLUDING the base path (Meta fetches images and calls webhooks here), e.g. https://your-app.vercel.app/business-live
NEXT_PUBLIC_APP_URL=

# Server-only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Encrypts every key customers save in Settings (AES-256-GCM). Required. Keep it safe: losing it makes saved keys unreadable.
SECRETS_ENCRYPTION_KEY=<random string, 32+ characters>
# Optional platform fallbacks, used only when an account has not set its own AI key / Meta secret
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
META_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
CRON_SECRET=<any long random string; the scheduler sends it as a Bearer token>
META_GRAPH_VERSION=v23.0
# Razorpay keys are per account (Settings page), not environment variables.
