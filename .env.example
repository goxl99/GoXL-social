# Copy to .env.local and fill in. Never commit .env.local.
NEXT_PUBLIC_SUPABASE_URL=https://hgdltduqwayfepzuurke.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<publishable anon key from Supabase > Settings > API>
NEXT_PUBLIC_BASE_PATH=/business-live
# Public URL of this app INCLUDING the base path (Meta fetches images and calls webhooks here), e.g. https://your-app.vercel.app/business-live
NEXT_PUBLIC_APP_URL=

# Server-only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
META_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=<any long random string you choose>
CRON_SECRET=<any long random string; the scheduler sends it as a Bearer token>
META_GRAPH_VERSION=v23.0
# Stage 4
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
